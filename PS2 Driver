library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

-- PS2 keyboard driver.
-- Receives the PS2 serial protocol (11-bit frames), filters the PS2 clock,
-- extracts the scan code and translates it to an ASCII character.
entity ps2_driver is
    Port ( 
        clk         : in  std_logic; -- E12 (FPGA pin) - System clock (50 MHz)
        rst         : in  std_logic; -- Reset assíncrono (Asynchronous reset)
        ps2_clk     : in  std_logic; -- W12 (FPGA pin) - PS2 clock, generated by the keyboard
        ps2_data    : in  std_logic; -- V11 (FPGA pin) - PS2 serial data
        char_ready  : out std_logic; -- One-cycle pulse: a new valid character is available on char_ascii
        char_ascii  : out std_logic_vector(7 downto 0) -- ASCII code of the key that was pressed
    );
end ps2_driver;

architecture rtl of ps2_driver is
    -- Shift register with the last 8 samples of ps2_clk (used as a glitch/debounce filter)
    signal ps2_clk_sync     : std_logic_vector(7 downto 0) := (others => '1');
    -- Filtered (clean) version of the PS2 clock
    signal ps2_clk_filter   : std_logic := '1';
    -- Previous value of the filtered clock (used for edge detection)
    signal ps2_clk_previous : std_logic := a'1';
    -- PS2 data sampled with the system clock (synchronizer)
    signal ps2_data_sync    : std_logic := '1';
    -- Pulses '1' for one system clock cycle on each falling edge of the filtered PS2 clock
    signal ps2_falling_edge : std_logic;
    
    -- Shift register holding one PS2 frame: start bit + 8 data bits + parity bit + stop bit
    signal shift_register   : std_logic_vector(10 downto 0) := (others => '0');
    -- Number of bits received so far in the current frame
    signal bit_count        : integer range 0 to 11 := 0;
    
    -- 8-bit scan code extracted from the frame
    signal scan_code  : std_logic_vector(7 downto 0);
    -- Pulses '1' for one clock cycle when a complete frame was received
    signal scan_ready : std_logic := '0';
    -- '1' when the previous scan code was 0xF0 (key release), so the next code must be ignored
    signal break_code : std_logic := '0';
begin

    -- Filtro de 8 pulsos
    -- 8-sample filter: the PS2 clock is only considered '1' after 8 consecutive '1' samples
    -- and only considered '0' after 8 consecutive '0' samples (removes noise/glitches)
    process(clk, rst)
    begin
        if rst = '1' then
            ps2_clk_sync <= (others => '1');
            ps2_clk_filter <= '1';
            ps2_clk_previous <= '1';
            ps2_data_sync <= '1';
        elsif rising_edge(clk) then
            -- Shift in the newest sample of ps2_clk
            ps2_clk_sync <= ps2_clk_sync(6 downto 0) & ps2_clk;
            -- Register the data line to synchronize it with the system clock
            ps2_data_sync <= ps2_data;
            if ps2_clk_sync = x"FF" then
                ps2_clk_filter <= '1';
            elsif ps2_clk_sync = x"00" then
                ps2_clk_filter <= '0';
            end if;
            -- Keep the old filtered value to detect edges
            ps2_clk_previous <= ps2_clk_filter;
        end if;
    end process;
    
    -- Detector de borda
    -- Edge detector: falling edge = previous '1' and current '0'
    ps2_falling_edge <= '1' when (ps2_clk_previous = '1' and ps2_clk_filter = '0') else '0';

    -- Leitura de pacote de 11 bits
    -- Reads an 11-bit packet: on each falling edge of the PS2 clock, one data bit is shifted in
    process(clk, rst)
    begin
        if rst = '1' then
            shift_register <= (others => '0');
            bit_count <= 0;
            scan_ready <= '0';
        elsif rising_edge(clk) then
            scan_ready <= '0'; -- Default: no new scan code
            if ps2_falling_edge = '1' then
                -- PS2 sends the LSB first, so new bits enter at the MSB and shift right
                shift_register <= ps2_data_sync & shift_register(10 downto 1);
                if bit_count = 10 then
                    -- 11th bit received: the frame is complete
                    scan_ready <= '1';
                    bit_count <= 0;
                else
                    bit_count <= bit_count + 1;
                end if;
            end if;
        end if;
    end process;
	 
	scan_code <= shift_register(8 downto 1); -- 8 bits de dados
	-- (8 data bits: bit 0 is the start bit, bits 8..1 are the data, bits 9 and 10 are parity and stop)

    -- Tradução Scan Code -> ASCII
    -- Scan code -> ASCII translation
    -- A key press sends its scan code; a key release sends 0xF0 followed by the same scan code.
    -- Only key presses generate characters, so the release sequence is discarded.
    process(clk, rst)
    begin
        if rst = '1' then
            char_ready <= '0';
            break_code <= '0';
        elsif rising_edge(clk) then
            char_ready <= '0'; -- Default: no new character
            if scan_ready = '1' then
                if scan_code = x"F0" then
                    -- Break prefix: the next scan code belongs to a key release
                    break_code <= '1';
                elsif break_code = '1' then
                    -- This is the scan code of the released key: ignore it
                    break_code <= '0';
                else
                    -- Normal key press: translate it and signal a valid character
                    char_ready <= '1';
                    case scan_code is
                        -- Letters A-Z (output in uppercase ASCII)
                        when x"1C" => char_ascii <= x"41"; -- A
                        when x"32" => char_ascii <= x"42"; -- B
                        when x"21" => char_ascii <= x"43"; -- C
                        when x"23" => char_ascii <= x"44"; -- D
                        when x"24" => char_ascii <= x"45"; -- E
                        when x"2B" => char_ascii <= x"46"; -- F
                        when x"34" => char_ascii <= x"47"; -- G
                        when x"33" => char_ascii <= x"48"; -- H
                        when x"43" => char_ascii <= x"49"; -- I
                        when x"3B" => char_ascii <= x"4A"; -- J
                        when x"42" => char_ascii <= x"4B"; -- K
                        when x"4B" => char_ascii <= x"4C"; -- L
                        when x"3A" => char_ascii <= x"4D"; -- M
                        when x"31" => char_ascii <= x"4E"; -- N
                        when x"44" => char_ascii <= x"4F"; -- O
                        when x"4D" => char_ascii <= x"50"; -- P
                        when x"15" => char_ascii <= x"51"; -- Q
                        when x"2D" => char_ascii <= x"52"; -- R
                        when x"1B" => char_ascii <= x"53"; -- S
                        when x"2C" => char_ascii <= x"54"; -- T
                        when x"3C" => char_ascii <= x"55"; -- U
                        when x"2A" => char_ascii <= x"56"; -- V
                        when x"1D" => char_ascii <= x"57"; -- W
                        when x"22" => char_ascii <= x"58"; -- X
                        when x"35" => char_ascii <= x"59"; -- Y
                        when x"1A" => char_ascii <= x"5A"; -- Z
                        -- Digits 0-9 (main keyboard row)
                        when x"45" => char_ascii <= x"30"; -- 0
                        when x"16" => char_ascii <= x"31"; -- 1
                        when x"1E" => char_ascii <= x"32"; -- 2
                        when x"26" => char_ascii <= x"33"; -- 3
                        when x"25" => char_ascii <= x"34"; -- 4
                        when x"2E" => char_ascii <= x"35"; -- 5
                        when x"36" => char_ascii <= x"36"; -- 6
                        when x"3D" => char_ascii <= x"37"; -- 7
                        when x"3E" => char_ascii <= x"38"; -- 8
                        when x"46" => char_ascii <= x"39"; -- 9
                        -- Control keys
                        when x"29" => char_ascii <= x"20"; -- Space
                        when x"5A" => char_ascii <= x"0D"; -- Enter
                        when x"66" => char_ascii <= x"08"; -- Backspace
                        -- Any other key is ignored (no character is signaled)
                        when others => char_ready <= '0';
                    end case;
                end if;
            end if;
        end if;
    end process;
end rtl;
